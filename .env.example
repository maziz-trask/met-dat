# Copy to .env and adjust. Never commit the real .env.
POSTGRES_DB=metdat
POSTGRES_USER=metdat
POSTGRES_PASSWORD=change-me
# JDBC settings used by the backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/metdat
SPRING_DATASOURCE_USERNAME=metdat
SPRING_DATASOURCE_PASSWORD=change-me
# >= 32 random characters; signs demo-login tokens. Generate: openssl rand -base64 48
APP_JWT_SECRET=replace-with-long-random-string-of-at-least-32-chars
# Demo mode (fixed seeded identities, server-verified roles)
APP_DEMO_ENABLED=true
# Attachment storage: "filesystem" (needs a persistent volume) or "database" (stored in PostgreSQL)
APP_STORAGE_TYPE=filesystem
APP_STORAGE_PATH=./data/attachments
APP_UPLOAD_MAX_FILE_SIZE=10MB
# Comma separated; only needed when frontend is served from another origin
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
